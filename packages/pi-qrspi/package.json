{
  "name": "@ftrdotdev/pi-qrspi",
  "version": "0.1.0",
  "homepage": "https://github.com/felixnorden/skills/blob/main/packages/pi-qrspi/README.md",
  "bugs": {
    "url": "https://github.com/felixnorden/skills/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felixnorden/skills.git",
    "path": "packages/pi-qrspi"
  },
  "files": [
    "prompts",
    "extensions",
    "skills/planning-workflow",
    "skills/tdd"
  ],
  "type": "module",
  "scripts": {
    "prepack": "rm -rf ./skills && mkdir -p ./skills && cp -R ../../skills/planning-workflow ./skills/ && cp -R ../../skills/tdd ./skills/ && rm -rf ./skills/planning-workflow/skills",
    "postpack": "rm -rf ./skills && ln -s ../../skills ./skills",
    "pack": "bun pm pack --destination ./dist",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c oxlint.config.ts",
    "lint:fix": "oxlint -c oxlint.config.ts --fix",
    "fmt": "oxfmt -c oxfmt.config.ts",
    "fmt:check": "oxfmt -c oxfmt.config.ts --check"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "typescript": ">=6.0.2"
  },
  "pi": {
    "prompts": [
      "./prompts"
    ],
    "skills": [
      "./skills/planning-workflow",
      "./skills/tdd"
    ],
    "extensions": [
      "./extensions"
    ]
  }
}
